# Copie para .env e ajuste. O .env não vai para o git.
# Sem .env, valem estes mesmos valores (padrão de desenvolvimento).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=kairos
DB_USER=kairos
DB_PASSWORD=kairos
DB_ROOT_PASSWORD=kairos-root

# Assistente de IA do médico (opcional). Sem KAIROS_IA_PROVEDOR, o painel não aparece.
# A chave fica só aqui ou na variável de ambiente, nunca no código nem no banco.
#
# Ordem de tentativa, separada por vírgula: claude, openai, gemini (ou google), deepseek, ollama, falso.
# Se o primeiro falhar, tenta o próximo. Provedor sem chave é pulado (aviso no log).
#KAIROS_IA_PROVEDOR=claude,gemini,deepseek,openai
#
# Uma chave por provedor (preencha só as que tiver)
#KAIROS_IA_CHAVE_CLAUDE=
#KAIROS_IA_CHAVE_OPENAI=
#KAIROS_IA_CHAVE_GEMINI=
#KAIROS_IA_CHAVE_DEEPSEEK=
#
# Modelo de cada um. Padrões: Claude claude-opus-5-5, Gemini gemini-3.5-flash, DeepSeek deepseek-chat.
# OpenAI e Ollama não têm padrão: informe o modelo.
#KAIROS_IA_MODELO_CLAUDE=claude-opus-5-5
#KAIROS_IA_MODELO_OPENAI=
#KAIROS_IA_MODELO_GEMINI=gemini-3.5-flash
#KAIROS_IA_MODELO_DEEPSEEK=deepseek-chat
#
# Esforço do Claude (low, medium ou high), limite de análises por médico por dia e espera máxima em segundos
#KAIROS_IA_ESFORCO=medium
#KAIROS_IA_LIMITE_DIARIO=30
#KAIROS_IA_TEMPO_MAXIMO=120
