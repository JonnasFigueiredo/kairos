<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.5//EN"
    "http://struts.apache.org/dtds/struts-2.5.dtd">

<struts>

	<!-- Desligado: o modo de desenvolvimento expõe detalhes internos na tela -->
	<constant name="struts.devMode" value="false" />
	<!-- Tema "simple": as tags geram só o campo, sem tabela em volta. O layout é do Bootstrap -->
	<constant name="struts.ui.theme" value="simple" />
	<!-- Método da Action não pode ser escolhido pela URL (action!metodo) -->
	<constant name="struts.enable.DynamicMethodInvocation" value="false" />
	<!-- Arquivo com os textos das telas -->
	<constant name="struts.custom.i18n.resources" value="ApplicationResources" />
	<constant name="struts.i18n.encoding" value="UTF-8" />
	<constant name="struts.locale" value="pt_BR" />
	<!-- O Struts não intercepta os arquivos do Bootstrap -->
	<constant name="struts.action.excludePattern" value="/webjars/.*" />

	<package name="kairos" extends="struts-default">

		<!-- Pilha padrão do Struts, com um ajuste: toda exceção não tratada vai para o log -->
		<interceptors>
			<interceptor-stack name="pilhaKairos">
				<!-- Guarda as mensagens na sessão durante um redirect e devolve na página seguinte -->
				<interceptor-ref name="store">
					<param name="operationMode">AUTOMATIC</param>
				</interceptor-ref>
				<interceptor-ref name="defaultStack">
					<param name="exception.logEnabled">true</param>
					<param name="exception.logLevel">ERROR</param>
					<!-- A consulta nunca volta ao formulário: mensagem de erro trazida de um redirect aparece na própria consulta -->
					<param name="workflow.excludeMethods">input,back,cancel,browse,listar</param>
				</interceptor-ref>
			</interceptor-stack>
		</interceptors>
		<default-interceptor-ref name="pilhaKairos" />

		<!-- Falha técnica em qualquer Action cai na página de erro, sem detalhe interno na tela -->
		<global-results>
			<result name="erroTecnico">/erro/erro.jsp</result>
		</global-results>
		<global-exception-mappings>
			<exception-mapping exception="br.com.kairos.exception.TechnicalException" result="erroTecnico" />
		</global-exception-mappings>

		<action name="inicio" class="br.com.kairos.action.InicioAction">
			<result>/inicio/inicio.jsp</result>
		</action>

		<!-- {1} é o trecho da URL antes de "Funcionarios": listarFuncionarios.action chama o método listar -->
		<action name="*Funcionarios" class="br.com.kairos.action.FuncionarioAction" method="{1}">
			<result name="success">/funcionario/cadFuncionario_b.jsp</result>
			<result name="input">/funcionario/cadFuncionario_i.jsp</result>
			<result name="redirect" type="redirectAction">listarFuncionarios</result>
			<!-- Só estes métodos podem ser chamados pela URL -->
			<allowed-methods>listar,novo,editar,salvar,excluir</allowed-methods>
		</action>

	</package>

</struts>
