<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.5//EN"
    "http://struts.apache.org/dtds/struts-2.5.dtd">

<struts>

	<!-- Desligado: o modo de desenvolvimento expõe detalhes internos na tela -->
	<constant name="struts.devMode" value="false" />
	<!-- Tema "simple": as tags geram só o campo, sem tabela em volta. O layout é do Bootstrap -->
	<constant name="struts.ui.theme" value="simple" />
	<!-- Método da Action não pode ser escolhido pela URL (action!metodo) -->
	<constant name="struts.enable.DynamicMethodInvocation" value="false" />
	<!-- Arquivo com os textos das telas -->
	<constant name="struts.custom.i18n.resources" value="ApplicationResources" />
	<constant name="struts.i18n.encoding" value="UTF-8" />
	<constant name="struts.locale" value="pt_BR" />
	<!-- O Struts não intercepta os arquivos do Bootstrap -->
	<constant name="struts.action.excludePattern" value="/webjars/.*" />

	<!-- json-default = struts-default + o tipo de resultado "json" (plugin), usado pelo assistente de IA -->
	<package name="kairos" extends="json-default">

		<interceptors>
			<!-- RN-AC-01: só deixa passar quem tem usuário na sessão -->
			<interceptor name="autenticacao" class="br.com.kairos.infra.AutenticacaoInterceptor" />
			<!-- RN-PE-02: confere a permissão do usuário no módulo da Action (parâmetro "modulo") -->
			<interceptor name="autorizacao" class="br.com.kairos.infra.AutorizacaoInterceptor" />

			<!-- Pilha padrão do Struts, com um ajuste: toda exceção não tratada vai para o log.
			     Sem login: usada só pela tela de login e pelas páginas de erro -->
			<interceptor-stack name="pilhaPublica">
				<!-- Guarda as mensagens na sessão durante um redirect e devolve na página seguinte -->
				<interceptor-ref name="store">
					<param name="operationMode">AUTOMATIC</param>
				</interceptor-ref>
				<interceptor-ref name="defaultStack">
					<param name="exception.logEnabled">true</param>
					<param name="exception.logLevel">ERROR</param>
					<!-- Estes métodos nunca voltam sozinhos ao formulário. Em "listar", o erro trazido de um redirect aparece na consulta;
					     em "editar", "excluir", "abrir" e "ver", código inválido na URL é tratado pela Action e volta à consulta;
					     em "analisar", a Action responde o erro em JSON, que é o que a tela do atendimento espera -->
					<param name="workflow.excludeMethods">input,back,cancel,browse,listar,editar,excluir,fila,abrir,ver,analisar</param>
				</interceptor-ref>
			</interceptor-stack>

			<!-- A mesma pilha, com os dois porteiros na frente. É a padrão: Action nova já nasce protegida.
			     Cada Action informa o módulo com <param name="autorizacao.modulo">; sem módulo, basta estar logado -->
			<interceptor-stack name="pilhaKairos">
				<interceptor-ref name="autenticacao" />
				<interceptor-ref name="autorizacao" />
				<interceptor-ref name="pilhaPublica" />
			</interceptor-stack>
		</interceptors>
		<default-interceptor-ref name="pilhaKairos" />

		<!-- Falha técnica em qualquer Action cai na página de erro, sem detalhe interno na tela -->
		<global-results>
			<!-- Passa pela ErroAction, que responde com HTTP 500 -->
			<result name="erroTecnico" type="chain">erro</result>
			<!-- Devolvido pelo interceptor de autenticação quando não há usuário na sessão -->
			<result name="login" type="redirectAction">abrirLogin</result>
			<!-- Devolvido pelo interceptor de autorização; a SemAcessoAction responde HTTP 403 -->
			<result name="semAcesso" type="chain">semAcesso</result>
		</global-results>
		<global-exception-mappings>
			<exception-mapping exception="br.com.kairos.exception.TechnicalException" result="erroTecnico" />
			<!-- Qualquer outro erro não previsto: mesma página, sem detalhe técnico na tela -->
			<exception-mapping exception="java.lang.Exception" result="erroTecnico" />
		</global-exception-mappings>

		<!-- Páginas de erro: "erro" responde 500 (ErroAction); "naoEncontrado" só entrega o JSP -->
		<action name="erro" class="br.com.kairos.action.ErroAction">
			<interceptor-ref name="pilhaPublica" />
			<result>/erro/erro.jsp</result>
		</action>
		<action name="naoEncontrado">
			<interceptor-ref name="pilhaPublica" />
			<result>/erro/naoEncontrado.jsp</result>
		</action>
		<action name="semAcesso" class="br.com.kairos.action.SemAcessoAction">
			<interceptor-ref name="pilhaPublica" />
			<result>/erro/semAcesso.jsp</result>
		</action>

		<!-- Login: abrirLogin, entrarLogin e sairLogin. Fora do porteiro, senão ninguém conseguiria entrar -->
		<action name="*Login" class="br.com.kairos.action.LoginAction" method="{1}">
			<interceptor-ref name="pilhaPublica" />
			<result name="success">/login/login.jsp</result>
			<result name="input">/login/login.jsp</result>
			<result name="redirect" type="redirectAction">inicio</result>
			<allowed-methods>abrir,entrar,sair</allowed-methods>
		</action>

		<action name="inicio" class="br.com.kairos.action.InicioAction">
			<result>/inicio/inicio.jsp</result>
		</action>

		<!-- {1} é o trecho da URL antes de "Funcionarios": listarFuncionarios.action chama o método listar -->
		<action name="*Funcionarios" class="br.com.kairos.action.FuncionarioAction" method="{1}">
			<interceptor-ref name="pilhaKairos">
				<param name="autorizacao.modulo">FUNCIONARIOS</param>
			</interceptor-ref>
			<result name="success">/funcionario/cadFuncionario_b.jsp</result>
			<result name="input">/funcionario/cadFuncionario_i.jsp</result>
			<result name="redirect" type="redirectAction">listarFuncionarios</result>
			<!-- Só estes métodos podem ser chamados pela URL -->
			<allowed-methods>listar,novo,editar,salvar,excluir</allowed-methods>
		</action>

		<action name="*Agendas" class="br.com.kairos.action.AgendaAction" method="{1}">
			<interceptor-ref name="pilhaKairos">
				<param name="autorizacao.modulo">AGENDAS</param>
			</interceptor-ref>
			<result name="success">/agenda/cadAgenda_b.jsp</result>
			<result name="input">/agenda/cadAgenda_i.jsp</result>
			<result name="redirect" type="redirectAction">listarAgendas</result>
			<allowed-methods>listar,novo,editar,salvar,excluir</allowed-methods>
		</action>

		<action name="*Compromissos" class="br.com.kairos.action.CompromissoAction" method="{1}">
			<interceptor-ref name="pilhaKairos">
				<param name="autorizacao.modulo">COMPROMISSOS</param>
			</interceptor-ref>
			<result name="success">/compromisso/cadCompromisso_b.jsp</result>
			<result name="input">/compromisso/cadCompromisso_i.jsp</result>
			<result name="redirect" type="redirectAction">listarCompromissos</result>
			<allowed-methods>listar,novo,editar,salvar,excluir</allowed-methods>
		</action>

		<action name="*Relatorio" class="br.com.kairos.action.RelatorioAction" method="{1}">
			<interceptor-ref name="pilhaKairos">
				<param name="autorizacao.modulo">RELATORIO</param>
			</interceptor-ref>
			<result name="success">/relatorio/relCompromissos.jsp</result>
			<!-- Data inválida no filtro: o Struts devolve "input" antes de chamar a Action -->
			<result name="input">/relatorio/relCompromissos.jsp</result>
			<!-- Em vez de uma página, devolve um arquivo: lê getArquivo() e getNomeDoArquivo() da Action -->
			<result name="excel" type="stream">
				<param name="contentType">application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</param>
				<param name="inputName">arquivo</param>
				<param name="contentDisposition">attachment;filename="${nomeDoArquivo}"</param>
			</result>
			<allowed-methods>abrir,gerar,excel</allowed-methods>
		</action>

		<!-- Atendimento do médico (RN-AT): fila, tela do atendimento, rascunho, liberação e retificação -->
		<action name="*Atendimento" class="br.com.kairos.action.AtendimentoAction" method="{1}">
			<interceptor-ref name="pilhaKairos">
				<param name="autorizacao.modulo">ATENDIMENTO</param>
			</interceptor-ref>
			<result name="success">/atendimento/fila.jsp</result>
			<result name="atendimento">/atendimento/atendimento.jsp</result>
			<!-- Erro de conversão (código do compromisso inválido): sem compromisso não há tela a mostrar -->
			<result name="input" type="redirectAction">filaAtendimento</result>
			<result name="redirect" type="redirectAction">filaAtendimento</result>
			<!-- Depois de gravar, volta à mesma tela do atendimento -->
			<result name="reabrir" type="redirectAction">
				<param name="actionName">abrirAtendimento</param>
				<param name="codigoCompromisso">${codigoCompromisso}</param>
			</result>
			<allowed-methods>fila,abrir,salvar,liberar,retificar</allowed-methods>
		</action>

		<!-- Assistente de IA (RN-IA): chamado por fetch da tela do atendimento, responde JSON -->
		<action name="analisarIa" class="br.com.kairos.action.AnaliseIaAction" method="analisar">
			<interceptor-ref name="pilhaKairos">
				<param name="autorizacao.modulo">ASSISTENTE_IA</param>
			</interceptor-ref>
			<!-- Serializa só o objeto "analise" da Action, não a Action inteira -->
			<result name="success" type="json">
				<param name="root">analise</param>
				<param name="excludeNullProperties">false</param>
			</result>
			<allowed-methods>analisar</allowed-methods>
		</action>

		<!-- Leitura dos resultados liberados (RN-AT-06) -->
		<action name="*Resultados" class="br.com.kairos.action.ResultadoAction" method="{1}">
			<interceptor-ref name="pilhaKairos">
				<param name="autorizacao.modulo">RESULTADOS</param>
			</interceptor-ref>
			<result name="success">/resultado/cadResultado_b.jsp</result>
			<result name="ver">/resultado/verResultado.jsp</result>
			<result name="redirect" type="redirectAction">listarResultados</result>
			<allowed-methods>listar,ver</allowed-methods>
		</action>

		<!-- Usuários e acessos (RN-PE). Sem "excluir": conta não se exclui, só se desativa -->
		<action name="*Usuarios" class="br.com.kairos.action.UsuarioAction" method="{1}">
			<interceptor-ref name="pilhaKairos">
				<param name="autorizacao.modulo">ACESSOS</param>
			</interceptor-ref>
			<result name="success">/usuario/cadUsuario_b.jsp</result>
			<result name="input">/usuario/cadUsuario_i.jsp</result>
			<result name="redirect" type="redirectAction">listarUsuarios</result>
			<allowed-methods>listar,novo,editar,salvar</allowed-methods>
		</action>

	</package>

</struts>
