<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
	version="3.1">

	<display-name>kairos</display-name>

	<!-- Porta de entrada do Struts: toda URL terminada em .action passa por este filtro -->
	<filter>
		<filter-name>struts2</filter-name>
		<filter-class>org.apache.struts2.dispatcher.filter.StrutsPrepareAndExecuteFilter</filter-class>
	</filter>

	<filter-mapping>
		<filter-name>struts2</filter-name>
		<url-pattern>*.action</url-pattern>
		<dispatcher>REQUEST</dispatcher>
		<dispatcher>FORWARD</dispatcher>
		<dispatcher>INCLUDE</dispatcher>
		<!-- ERROR: as páginas de erro abaixo também passam pelo Struts -->
		<dispatcher>ERROR</dispatcher>
	</filter-mapping>

	<!-- Página aberta quando a URL é só /kairos -->
	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>

	<!-- Erros que acontecem fora das Actions (endereço inexistente, JSP aberto direto, falha na inicialização):
	     o usuário vê uma página do sistema, e não a página técnica do servidor -->
	<error-page>
		<error-code>404</error-code>
		<location>/naoEncontrado.action</location>
	</error-page>
	<error-page>
		<error-code>500</error-code>
		<location>/erro.action</location>
	</error-page>
	<error-page>
		<exception-type>java.lang.Throwable</exception-type>
		<location>/erro.action</location>
	</error-page>

	<!-- Os JSPs só abrem pelas Actions, que preparam os dados da tela. Aberto direto pela URL,
	     o JSP quebraria; o servidor recusa (403) e mostra a página de não encontrado.
	     O encaminhamento feito pelo Struts não passa por esta regra -->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>jsp</web-resource-name>
			<url-pattern>/agenda/*</url-pattern>
			<url-pattern>/atendimento/*</url-pattern>
			<url-pattern>/compromisso/*</url-pattern>
			<url-pattern>/erro/*</url-pattern>
			<url-pattern>/funcionario/*</url-pattern>
			<url-pattern>/inicio/*</url-pattern>
			<url-pattern>/login/*</url-pattern>
			<url-pattern>/relatorio/*</url-pattern>
			<url-pattern>/resultado/*</url-pattern>
			<url-pattern>/usuario/*</url-pattern>
		</web-resource-collection>
		<auth-constraint/>
	</security-constraint>
	<error-page>
		<error-code>403</error-code>
		<location>/naoEncontrado.action</location>
	</error-page>
	<session-config>
		<session-timeout>30</session-timeout>
		<!-- Sessão só por cookie: sem ";jsessionid=..." nos links -->
		<cookie-config>
			<!-- JavaScript da página não lê o cookie: um XSS não leva a sessão junto -->
			<http-only>true</http-only>
		</cookie-config>
		<tracking-mode>COOKIE</tracking-mode>
	</session-config>
</web-app>
